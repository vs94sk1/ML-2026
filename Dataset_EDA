print()
print("ПРОВЕРКА ГИПОТЕЗЫ О РАЗЛИЧИИ СУИЦИДОВ ПО ПОЛУ")



male_data = df[df['sex'] == 'male']['suicides/100k pop'].dropna()
female_data = df[df['sex'] == 'female']['suicides/100k pop'].dropna()

print(f"\nРазмер выборки (мужчины): {len(male_data)}")
print(f"Размер выборки (женщины): {len(female_data)}")
print(f"Среднее (мужчины): {male_data.mean():.2f}")
print(f"Среднее (женщины): {female_data.mean():.2f}")
print(f"Медиана (мужчины): {male_data.median():.2f}")
print(f"Медиана (женщины): {female_data.median():.2f}")


t_stat, p_value_t = stats.ttest_ind(male_data, female_data, equal_var=False)
print(f"\nT-тест Уэлча")
print(f"t-статистика: {t_stat:.4f}")
print(f"p-value: {p_value_t:.4e}")


u_stat, p_value_u = stats.mannwhitneyu(male_data, female_data, alternative='two-sided')
print(f"\nU-критерий Манна-Уитни")
print(f"U-статистика: {u_stat:.4f}")
print(f"p-value: {p_value_u:.4e}")


alpha = 0.05
print(f"\n--- Вывод (уровень значимости α = {alpha}) ---")
if p_value_t < alpha:
    print("Отвергаем H0 (t-тест): Различия статистически значимы.")
else:
    print("Не отвергаем H0 (t-тест): Различия не значимы.")

if p_value_u < alpha:
    print("Отвергаем H0 (U-тест): Различия статистически значимы.")
else:
    print("Не отвергаем H0 (U-тест): Различия не значимы.")

